# Единый файл переменных окружения для dev.
# Скопируйте в корне репозитория: cp .env.example .env

# --- API (apps/api) ---
PORT=3001
MONGODB_URI=mongodb://localhost:27017/plant_care
WEATHER_DEFAULT_CITY=Москва

# ollama | openai
LLM_PROVIDER=ollama
LLM_TIMEOUT_MS=120000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Ключ только для LLM_PROVIDER=openai. Не коммитьте заполненное значение.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Web (apps/web) ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3001

# --- MongoDB (docker-compose) ---
# При смене MONGO_PORT обновите также MONGO_PORT в MONGODB_URI выше.
MONGO_PORT=27017
