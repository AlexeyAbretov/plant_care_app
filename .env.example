# Единый файл переменных окружения для dev.
# Скопируйте в корне репозитория: cp .env.example .env

# --- API (apps/api) ---
PORT=3001
MONGODB_URI=mongodb://localhost:27017/plant_care
WEATHER_DEFAULT_CITY=Москва

# Имя файла apps/api/src/services/<имя>.client.ts: ollama, openai, google, grok.
# Меняйте LLM_API_KEY, LLM_MODEL и LLM_BASE_URL под выбранный провайдер.
LLM_PROVIDER=ollama
LLM_TIMEOUT_MS=120000
# LLM_API_KEY=
LLM_MODEL=qwen2.5vl:7b
LLM_BASE_URL=http://localhost:11434

# --- Web (apps/web) ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3001

# --- MongoDB (docker-compose) ---
# При смене MONGO_PORT обновите также MONGO_PORT в MONGODB_URI выше.
MONGO_PORT=27017
