# Единый файл переменных окружения для dev.
# Скопируйте в корне репозитория: cp .env.example .env

# --- API (apps/api) ---
PORT=3001
MONGODB_URI=mongodb://localhost:27017/plant_care
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=120000
WEATHER_DEFAULT_CITY=Москва

# --- Web (apps/web) ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3001

# --- MongoDB (docker-compose) ---
# При смене MONGO_PORT обновите также MONGO_PORT в MONGODB_URI выше.
MONGO_PORT=27017
