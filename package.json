{
  "name": "plant-care-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mongo": "node scripts/dev.mjs mongo",
    "dev:apps": "node scripts/dev.mjs apps",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "storybook": "npm run storybook -w @plant-care/web"
  },
  "devDependencies": {
    "@llm/linting": "workspace:*",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.3"
  },
  "prettier": "@llm/linting/prettier",
  "engines": {
    "node": ">=22"
  }
}
